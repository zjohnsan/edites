# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.venv
venv/
ENV/

# Archivos de video y renderizados pesados / temporales
clips-entrada/*
!clips-entrada/.gitkeep
clips-procesados/*
!clips-procesados/.gitkeep
shorts-salida/*
!shorts-salida/.gitkeep
*.mp4
*.mkv
*.avi
*.mov
!public/sfx/**

# Archivos temporales de clips generados
public/vertical_temp.mp4
public/clips/*
!public/clips/.gitkeep

# Archivos binarios, comprimidos y música pesada (se conservan los catálogos JSON)
*.rar
*.zip
tools/
musica/**/*.mp3
musica/**/*.wav
public/musica/**/*.mp3
public/musica/**/*.wav

# Logs y SO
*.log
.DS_Store
Thumbs.db
